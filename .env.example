# Directory containing your GGUF model files. Bind-mounted into the
# container as /models (read-only). Relative paths are resolved from this
# repository; absolute paths are used as-is.
# If omitted, ./models inside this repository is used.
#
# Windows example: MODELS_DIR=C:/Users/TM/turboquant-setup/models
# Linux example:   MODELS_DIR=/home/tm/models/gguf
MODELS_DIR=./models
